{ "version": 2, "builds": [{ "src": "web/dist/**", "use": "@vercel/static" }, { "src": "server/src/index.js", "use": "@vercel/node" }], "routes": [{ "src": "/api/(.*)", "dest": "server/src/index.js" }, { "src": "/(.*)", "dest": "web/dist/$1" }], "env": { "RAZORPAY_KEY_ID": "@razorpay-key-id", "RAZORPAY_KEY_SECRET": "@razorpay-key-secret" } }
