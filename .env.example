# Razorpay Test Mode — dashboard.razorpay.com -> Settings -> API Keys -> Test
# Use rzp_test_ keys + secret -> real Orders order_* via api.razorpay.com/v1/orders (amount paise, signature verify).
# Razorpay API uses a single endpoint (api.razorpay.com) for both test and live modes.
# rzp_test_* keys automatically use test mode; rzp_live_* keys use live mode.
# test.razorpay.com is an alias for the same endpoint.
# Without keys -> mock order_mock_* (hidden behind /docs, not landing badge).
# PostgreSQL connection (required for production). AgentCart uses pg Pool.
DATABASE_URL=postgresql://user:pass@localhost:5432/agentcart
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret
# Webhook secret for signature verify (dashboard -> Webhooks) — HMAC SHA256 x-razorpay-signature
RAZORPAY_WEBHOOK_SECRET=whsec_xxx
# Dummy pay in Test Mode: Checkout.js success@razorpay / failure@razorpay, cards 4111111111111111 / 5105105105105100 / 378282246310005 (per docs/architecture.md:40)
PORT=3001
WEB_URL=http://localhost:5173
MCP_PORT=3002
# Reserve Pay SBMD limits (live: max 10000, 90d) — bounded: total <= remaining, stock, expiry, consent (audit checkout_blocked_exceeds_reserve + fallback Payment Link audit-logged not front-center)
RESERVE_MAX_BLOCK=10000
RESERVE_VALID_DAYS=90
# Agent-facing HMAC auth (agent_id:secret, comma-separated). Gate POST /api/reserve/create,
# /api/checkout/create, /api/approval/request-token, /api/agent/login.
# Each request must include x-agent-id, x-nonce, x-timestamp, x-signature where:
#   signature = HMAC-SHA256(secret, METHOD + PATH + TIMESTAMP + NONCE + BODY)
# Timestamp within 60s + nonce not reused (replay protection). Never expose these secrets in /llms.txt or headers.
# Human approval uses a short-lived capability (x-capability), never a static key.
AGENT_SECRETS=agent_demo:demo_agent_secret_change_me_01
